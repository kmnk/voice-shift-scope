<?xml version="1.0" encoding="utf-8"?>
<!--
  The shape of the artifact sent to SignPath for signing. The build job of release.yml uploads only the 2 exes as the artifact unsigned-exe,
  and actions/upload-artifact zips it, so the root is zip-file. Copy this into the artifact configuration on the SignPath site.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="voice-shift-scope.exe">
      <authenticode-sign/>
    </pe-file>
    <pe-file path="voice-cli.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
